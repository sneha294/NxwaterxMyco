setwd("~/Documents/Experiment_I/Carbon_nitrogen_analysis")
setwd("~/Documents/Experiment_I/Carbon_nitrogen_analysis")
library(dplyr)
library(readxl)
library(tidyr)
library(car)
library(emmeans)
library(lme4)
library(ggplot2)
Leaf_costech <- read_excel("Leaf_carbon_nitrogen.xlsx")
Stem_costech <- read_excel("Stem_carbon_nitrogen.xlsx")
Root_costech <- read_excel("Root_carbon_nitrogen.xlsx")
metadata <- read_excel("metadata.xlsx")
merge_costech <- Leaf_costech %>%
left_join(Stem_costech, by = "Sample") %>%
left_join(Root_costech, by = "Sample") %>%
left_join( metadata, by = "Sample")
merge_costech <- merge_costech %>%
mutate(Whole_plant_nitrogen_biomass = `Total Leaf nitrogen biomass`+ `Total Root nitrogen biomass`+ `Total stem nitrogen biomass`,
Carbon_cost_to_acquire_nutrients = `Total root carbon biomass`/ Whole_plant_nitrogen_biomass)
View(merge_costech)
CC_lmer <- lmer(Carbon_cost_to_acquire_nutrients ~ Water_treatment * Nutrient_treatment * AMF + (1|Block_ID), data = merge_costech)
Anova(CC_lmer)
summary(CC_lmer)
hist(residuals(CC_lmer))
shapiro.test(residuals(CC_lmer))
plot(CC_lmer)
# emmeans for carbon cost
em_CC <- as.data.frame(emmeans(CC_lmer, ~AMF| Nutrient_treatment * Water_treatment))
ggplot(merge_costech, aes(y = Carbon_cost_to_acquire_nutrients, x = AMF , color = AMF)) + geom_jitter(width = 0.2, size = 2, alpha = 0.8)  +
geom_point(data = em_CC, aes(y = emmean, x = AMF),
shape = 18, size = 3, color = "black", inherit.aes = FALSE) +
geom_errorbar(data = em_CC, aes(x = AMF, y = emmean,ymin = emmean - SE, ymax = emmean + SE),  width = 0.15, linewidth = 1, color = "black", alpha = 0.6, inherit.aes = FALSE) +
scale_color_manual(values = c("red", "dodgerblue")) +
labs(x = "AMF Presence/Absence",
y = "Carbon cost to acquire and use nutrients") +
facet_grid(Water_treatment ~ Nutrient_treatment,
labeller = labeller(Water_treatment = c("Well watered" = "Well Watered", "Drought" = "Drought Condition"),Nutrient_treatment = c("Low nitrogen" = "Low N",
"High nitrogen" = "High N"))) +  theme_bw(base_size = 14)
ggsave("Treatment_CC.jpg", width = 10, height = 7, units = "in", dpi = 600)
