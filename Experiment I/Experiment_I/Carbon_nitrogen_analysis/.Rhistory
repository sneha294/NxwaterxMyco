# fit model based on hypothesis (Jmax)
Jmax_lmer <- lmer(Jmax ~ Water_treatment * Nutrient_treatment * AMF + (1|Block_ID),
data = merge_stats)
Anova(Jmax_lmer)
summary(Jmax_lmer)
hist(residuals(Jmax_lmer))
shapiro.test(residuals(Jmax_lmer)) # normal distribution
plot(Jmax_lmer)
