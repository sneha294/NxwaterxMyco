# merging metadata with stable isotope excel sheet
merge_1 <-merge(stable_isotope, metadata, by = "Sample")
View(merge_1)
Chi_lmer <- lmer(sqrt(chi) ~ Water_treatment * Nutrient_treatment * AMF + (1|Block_ID),
data = merge_1)
