CC_lmer <- lmer(Carbon_cost_to_acquire_nutrients ~ Water_treatment * Nutrient_treatment * AMF + (1|Block_ID), data = merge_costech)
Anova(CC_lmer)
summary(CC_lmer)
hist(residuals(CC_lmer))
shapiro.test(residuals(CC_lmer))
plot(CC_lmer)
# emmeans for carbon cost
